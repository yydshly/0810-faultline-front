{
  "name": "faultline-front-prototype",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "release:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/package_release.ps1",
    "assets:ktx2": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/compress_glb_ktx2.ps1",
    "assets:validate:ktx2": "python tools/validate_glb_contracts.py public/assets/models --require-ktx2",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
